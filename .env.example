# Adaptive Academy — environment. Copy to `.env` and fill in. `.env` is gitignored.

# --- Required: bring your own key (BYOK) ---
# Your Anthropic API key. The app runs entirely on your own key; nothing is proxied.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Optional: LLM backend ---
# Leave unset (default) to use the Anthropic API with the key above.
# Set to `agent_sdk` to use a Claude subscription via the Claude Agent SDK instead
# (host-only; drops ANTHROPIC_API_KEY at startup). Slower, but no per-token billing.
# AA_LLM_BACKEND=agent_sdk

# --- Optional: model ids ---
# Defaults: claude-sonnet-5-5 (reasoning) and claude-haiku-5-5 (copy). Set these only if
# a model is retired or not available to your key, then restart the API. Blank = default.
# AA_MODEL_REASONING=claude-sonnet-5-5
# AA_MODEL_COPY=claude-haiku-5-5

# --- Optional: daily spending limit ---
# Refuse new API-key model calls (HTTP 429) once today's recorded spend (at list price, server's
# local day) reaches this many USD. A soft cap: the call that crosses it can overshoot. Must be a
# number >= 0; 0 blocks every API-key call; blank or unset = no limit. While a limit is set, a
# model with no known price (see llm/pricing.py) is refused, since its spend can't be counted.
# Agent SDK (subscription) calls are never blocked.
# AA_DAILY_BUDGET_USD=5

# --- Optional: database (prefix is AA_) ---
# SQLite database URL. Default is a local file in the working directory.
AA_DATABASE_URL=sqlite:///./adaptive_academy.db

# --- Optional: Obsidian vault integration ---
# HOST path to your vault. Used by docker compose to bind-mount it to /vault.
# Leave it commented out if you don't use Obsidian (compose then mounts an empty ./data/vault).
# OBSIDIAN_VAULT_PATH="/absolute/path/to/your/obsidian/vault"
# Path the APP reads the vault from. Under docker compose this is fixed to /vault
# (see docker-compose.yml); set it directly only when running on the host.
# AA_OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian/vault

# --- Optional: time zone (Docker only) ---
# The container's clock is UTC unless you set this. It decides "today" for the daily
# spending limit and the date the agents are told. Use an IANA name. On the host, the
# app already uses your machine's time zone.
# TZ=America/Los_Angeles

# --- Optional: container user (Docker only) ---
# The uid/gid the app runs as inside the container (default 1000/1000; it never runs as
# root). On Linux, set these to your own `id -u` / `id -g` (as numbers) so the notes it
# exports into your vault are owned by you. Not needed on macOS.
# AA_UID=1000
# AA_GID=1000

# --- Optional: `just dev` ports (local only) ---
# AA_API_PORT=8000
# AA_WEB_PORT=5173
